# =========================================================
# Spring Boot Microservices - Global .gitignore
# Covers Maven/Gradle builds, IDE files, logs, temp files,
# and sensitive local configuration.
# =========================================================

# -----------------------------
# Build outputs
# -----------------------------
**/target/
**/build/
**/out/
**/bin/

# Keep Maven/Gradle wrapper JARs tracked
!**/.mvn/wrapper/maven-wrapper.jar
!**/gradle/wrapper/gradle-wrapper.jar

# -----------------------------
# Compiled and packaged artifacts
# -----------------------------
**/*.class
**/*.jar
**/*.war
**/*.ear

# -----------------------------
# Logs and runtime dumps
# -----------------------------
**/*.log
**/logs/
**/log/
**/*.pid
**/*.seed
**/*.stackdump
hs_err_pid*
replay_pid*

# -----------------------------
# Java / JVM cache
# -----------------------------
**/.classpath
**/.project
**/.settings/
**/.factorypath
**/.apt_generated/
**/.springBeans
**/.sts4-cache/

# -----------------------------
# Maven / Gradle local cache files
# -----------------------------
**/.gradle/
**/.mvn/timing.properties

# -----------------------------
# IntelliJ IDEA
# -----------------------------
**/.idea/
**/*.iml
**/*.iws
**/*.ipr

# -----------------------------
# VS Code
# -----------------------------
**/.vscode/

# -----------------------------
# OS-generated files
# -----------------------------
**/.DS_Store
**/Thumbs.db
**/Desktop.ini

# -----------------------------
# Environment and sensitive config
# -----------------------------
**/.env
**/.env.*
**/application.properties
**/application.yml
**/application.yaml
**/bootstrap.properties
**/bootstrap.yml
**/bootstrap.yaml

# Keep EurekaServer application.properties tracked
!EurekaServer/src/main/resources/application.properties

# Keep template/example config files if used
!**/.env.example
!**/application-example.properties
!**/application-example.yml
!**/application-example.yaml

# -----------------------------
# Temporary files and caches
# -----------------------------
**/*.tmp
**/*.temp
**/*.swp
**/*.swo
**/*~
**/.cache/
**/.tmp/
**/tmp/

# -----------------------------
# Test artifacts and reports
# -----------------------------
**/surefire-reports/
**/failsafe-reports/
**/test-output/
**/jacoco.exec
**/jacoco/
**/coverage/
